<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Allow cleartext HTTP connections to your local development IP -->
        <domain includeSubdomains="true">192.168.0.115</domain>
        <domain includeSubdomains="true">192.168.0.126</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Optional: standard Android emulator loopback IP -->
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>